@using Carmasters.Core.Application.Configuration
@using Carmasters.Core.Application.Model
@using Carmasters.Core.Domain
@using Carmasters.Http.Api
@model PricingPrintModel
@{
    var pricing = (Pricing)Model.Pricing;
    var requisitesOptions = (RequisitesOptions)Model.RequisitesOptions;
    var pricingOptions = (PricingOptions)Model.PricingOptions;
    var isInvoice = pricing is Carmasters.Core.Domain.Invoice;
    var invoice = pricing as Carmasters.Core.Domain.Invoice;
    var hasDiscounts = pricing.Lines.Any(x => x.Discount != 0);
    var totalExVat = pricing.GetTotal(false);
    var totalInclVat = pricing.GetTotal(true);
    var vatAmount = totalInclVat - totalExVat;
}

<!-- Top band: company identity left, document title right -->
<div class="grid grid-cols-2 items-start">
    <div>
        <h1 class="text-2xl font-bold text-gray-900" id="logo">@requisitesOptions.Name</h1>
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Address))
        {
            <p class="text-sm text-gray-600 mt-0.5">@requisitesOptions.Address</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.RegNr))
        {
            <p class="text-sm text-gray-600">Reg. no: @requisitesOptions.RegNr</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.KMKR))
        {
            <p class="text-sm text-gray-600">VAT no: @requisitesOptions.KMKR</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Phone))
        {
            <p class="text-sm text-gray-600">@requisitesOptions.Phone</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Email))
        {
            <p class="text-sm text-gray-600">@requisitesOptions.Email</p>
        }
    </div>
    <div class="text-right">
        <p class="text-3xl font-bold tracking-tight text-indigo-600 uppercase">
            @(isInvoice ? "Invoice" : "Estimate")
        </p>
        <p class="text-lg font-semibold text-gray-900 mt-1">@(pricing.GetDisplayName())</p>
        @if (isInvoice && invoice != null)
        {
            <p class="text-sm text-gray-600 mt-2">Date: @invoice.IssuedOn.ToString("dd.MM.yyyy")</p>
            <p class="text-sm text-gray-600">Due: @invoice.IssuedOn.AddDays(invoice.DueDays).ToString("dd.MM.yyyy")</p>
        }
    </div>
</div>

<!-- Bill-to and Vehicle blocks -->
<div class="grid grid-cols-2 gap-8 mt-8 pt-6 border-t border-gray-200">
    <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Bill to</p>
        <p class="text-sm font-semibold text-gray-900">@pricing.PartyName</p>
        @if (!string.IsNullOrWhiteSpace(pricing.PartyCode))
        {
            <p class="text-sm text-gray-600">Reg. code: @pricing.PartyCode</p>
        }
        @if (!string.IsNullOrWhiteSpace(pricing.PartyAddress))
        {
            <p class="text-sm text-gray-600">@pricing.PartyAddress</p>
        }
    </div>
    <div>
        @if (!string.IsNullOrWhiteSpace(pricing.VehicleLine1))
        {
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-2">Vehicle</p>
            <p class="text-sm text-gray-900">@pricing.VehicleLine1</p>
            @if (!string.IsNullOrWhiteSpace(pricing.VehicleLine2))
            {
                <p class="text-sm text-gray-600">@pricing.VehicleLine2</p>
            }
            @if (!string.IsNullOrWhiteSpace(pricing.VehicleLine3))
            {
                <p class="text-sm text-gray-600">@pricing.VehicleLine3</p>
            }
            @if (!string.IsNullOrWhiteSpace(pricing.VehicleLine4))
            {
                <p class="text-sm text-gray-600">@pricing.VehicleLine4</p>
            }
        }
    </div>
</div>

<!-- Line items table -->
<table class="mt-8 min-w-full">
    <thead>
        <tr class="border-b-2 border-gray-900">
            <th class="pl-0 pr-3 py-2 text-left text-xs font-semibold uppercase tracking-wider text-gray-500">Description</th>
            <th class="px-3 py-2 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Qty</th>
            <th class="px-3 py-2 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Unit</th>
            <th class="px-3 py-2 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Unit price</th>
            @if (hasDiscounts)
            {
                <th class="px-3 py-2 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Disc.&nbsp;%</th>
            }
            <th class="pl-3 pr-0 py-2 text-right text-xs font-semibold uppercase tracking-wider text-gray-500">Amount</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in pricing.Lines)
        {
            <tr class="border-b border-gray-200">
                <td class="pl-0 pr-3 py-2.5 text-sm text-gray-900">@item.Description</td>
                <td class="px-3 py-2.5 text-sm text-right text-gray-700 whitespace-nowrap">@item.Quantity</td>
                <td class="px-3 py-2.5 text-sm text-right text-gray-700 whitespace-nowrap">@item.Unit</td>
                <td class="px-3 py-2.5 text-sm text-right text-gray-700 whitespace-nowrap">@(item.UnitPrice.ToString("0.00"))</td>
                @if (hasDiscounts)
                {
                    <td class="px-3 py-2.5 text-sm text-right text-gray-700 whitespace-nowrap">@((item.Discount != null && item.Discount != 0) ? $"{item.Discount}%" : "")</td>
                }
                <td class="pl-3 pr-0 py-2.5 text-sm text-right font-medium text-gray-900 whitespace-nowrap">@item.Total.ToString("0.00")</td>
            </tr>
        }
    </tbody>
</table>

<!-- Totals box — right-aligned -->
<div class="flex justify-end mt-6">
    <div class="w-64">
        <div class="flex justify-between py-1.5 text-sm text-gray-600">
            <span>Subtotal</span>
            <span>@totalExVat.ToString("0.00") EUR</span>
        </div>
        @if (hasDiscounts)
        {
            <div class="flex justify-between py-1.5 text-sm text-gray-600">
                <span>Discount</span>
                <span>included</span>
            </div>
        }
        <div class="flex justify-between py-1.5 text-sm text-gray-600">
            <span>VAT@(pricingOptions?.Invoice?.VatRate > 0 ? $" ({pricingOptions.Invoice.VatRate}%)" : "")</span>
            <span>@vatAmount.ToString("0.00") EUR</span>
        </div>
        <div class="flex justify-between pt-3 mt-2 border-t-2 border-gray-900 text-base font-bold text-gray-900">
            <span>Total due</span>
            <span>@totalInclVat.ToString("0.00") EUR</span>
        </div>
    </div>
</div>

<!-- Payment details -->
@if (isInvoice)
{
    <div class="mt-8 pt-6 border-t border-gray-200">
        <p class="text-xs font-semibold uppercase tracking-wider text-gray-400 mb-3">Payment details</p>
        <div class="grid grid-cols-2 gap-x-8">
            <div>
                @if (!string.IsNullOrWhiteSpace(requisitesOptions.BankAccount))
                {
                    <p class="text-sm text-gray-700"><span class="text-gray-500">Bank account:</span> @requisitesOptions.BankAccount</p>
                }
                @if (invoice != null)
                {
                    <p class="text-sm text-gray-700 mt-1">
                        <span class="text-gray-500">Payment:</span>
                        @(invoice.PaymentType == PaymentType.Cash ? "Cash" : "Bank transfer")
                    </p>
                }
            </div>
            <div>
                @if (pricingOptions?.Invoice != null && !string.IsNullOrWhiteSpace(pricingOptions.Invoice.SurCharge))
                {
                    <p class="text-sm text-gray-700"><span class="text-gray-500">Late fee:</span> @pricingOptions.Invoice.SurCharge</p>
                }
            </div>
        </div>
    </div>
}

<!-- Disclaimer -->
@if (pricingOptions?.Invoice != null && !string.IsNullOrWhiteSpace(pricingOptions.Invoice.Disclaimer))
{
    <div class="mt-4">
        <p class="text-xs text-gray-500 whitespace-pre-line">@pricingOptions.Invoice.Disclaimer</p>
    </div>
}

<!-- Signature lines -->
@if (isInvoice && pricingOptions?.Invoice?.SignatureLine == true)
{
    <div class="grid grid-cols-2 gap-16 mt-12">
        <div>
            <div class="border-t border-gray-400 pt-2">
                <p class="text-xs text-gray-500">Issued by</p>
                @if (invoice?.Issuer != null)
                {
                    <p class="text-sm text-gray-700 mt-1">@invoice.Issuer.Name</p>
                }
            </div>
        </div>
        <div>
            <div class="border-t border-gray-400 pt-2">
                <p class="text-xs text-gray-500">Received by</p>
            </div>
        </div>
    </div>
}

<!-- Footer (screen hidden, PDF fixed-bottom via print.css) -->
<footer class="border-t border-gray-200 w-full grid grid-cols-2 mt-8 pt-3">
    <div>
        <p class="text-xs text-gray-500">@requisitesOptions.Name</p>
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Address))
        {
            <p class="text-xs text-gray-500">@requisitesOptions.Address</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.Email))
        {
            <p class="text-xs text-gray-500">@requisitesOptions.Email</p>
        }
    </div>
    <div class="text-right">
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.BankAccount))
        {
            <p class="text-xs text-gray-500">@requisitesOptions.BankAccount</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.RegNr))
        {
            <p class="text-xs text-gray-500">Reg. code: @requisitesOptions.RegNr</p>
        }
        @if (!string.IsNullOrWhiteSpace(requisitesOptions.KMKR))
        {
            <p class="text-xs text-gray-500">VAT no: @requisitesOptions.KMKR</p>
        }
    </div>
</footer>
